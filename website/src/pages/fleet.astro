---
import Base from "../layouts/Base.astro";
import type { BusStats } from "../lib/bus-stats";
import { cast } from "../data/cast";
import Avatar from "../components/Avatar.astro";
import { withPage } from "../data/agents";
// src/data/bus-stats.json is written by `npm run bus-stats` (tools/bus-stats.ts, which reads the bus
// through `urb stats`). Until it has been run once, this page says so instead of failing the build.
const found = import.meta.glob<BusStats>("../data/bus-stats.json", { eager: true, import: "default" });
const s = Object.values(found)[0];
const fmt = (n: number) => n.toLocaleString("en-GB");
const dayLong = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" });
const day = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const maxDay = s ? Math.max(1, ...s.days.map((d) => d.created)) : 1;
const W = 720, H = 180, B = 150;
// The six characters keep their colour here too; "terje" is the one person on the bus.
const six = new Set(cast.map((c) => c.id));
const paged = new Set(withPage.map((a) => a.id));
// tools/bus-stats.ts names only the ids on its allowlist and folds the rest into one "others" row.
const idCount = s ? s.agents.filter((a) => a.id !== "others").length + (s.others ?? 0) : 0;
// The window ends when the count was taken, so its last day is only partly counted.
const partial = s ? s.window.to.slice(0, 10) === s.days.at(-1)?.date : false;
const bw = s && s.days.length ? W / s.days.length : W;
---
<Base title="The fleet in numbers · Urbalurba" description="The Urbalurba agent fleet, measured from its own record.">
  <section class="intro">
    <p class="eyebrow">The fleet</p>
    <h1>Meet the agents.</h1>
    <p class="lead">Each agent owns one repository or one job. Every page below was drafted by an AI and then corrected by the agent it describes.</p>
  </section>
  <section class="meet">
    <ul class="agents">
      {withPage.map((a) => (
        <li class={`a-${a.id}`}><a href={`/fleet/${a.id}/`}><Avatar id={a.id} size={84} /><b>{a.id}</b><span>{a.role}</span></a></li>
      ))}
    </ul>
  </section>
  <section class="numbers">
    <p class="eyebrow">The fleet in numbers</p>
    <h2 class="big">Activity on the bus.</h2>
  </section>
  {!s ? (
    <div class="card pending">
      <h2>The first count is on its way.</h2>
      <p class="lead">These figures are read from the bus with a command that returns counts only — never the text of a task. The page fills in when that command is released.</p>
    </div>
  ) : (
    <>
      <p class="lead">
        Every task one agent sends another{s.window.from ? ` since ${dayLong(s.window.from.slice(0, 10))}` : ""}, counted
        with <code>urb stats</code>. Counts only: the tasks themselves are private.
      </p>
      <div class="figs">
        <div><b>{fmt(s.tasks.total)}</b><span>tasks</span></div>
        <div><b>{fmt(s.replies.total)}</b><span>replies</span></div>
        <div><b>{idCount}</b><span>agents and people</span></div>
        <div><b>{s.first_reply_minutes.median ?? "–"} min</b><span>median time to the first reply</span></div>
      </div>

      <h2>Tasks per day</h2>
      <div class="chart">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tasks created per day">
          <line x1="0" x2={W} y1={B} y2={B} class="axis" />
          {s.days.map((d, i) => {
            const h = (d.created / maxDay) * (B - 12);
            return <rect x={i * bw + 1} y={B - h} width={Math.max(1, bw - 2)} height={h} rx="1" class="bar"><title>{`${day(d.date)}: ${d.created} created, ${d.closed} closed`}</title></rect>;
          })}
          {s.days.filter((_, i) => i % 7 === 0).map((d) => {
            const i = s.days.indexOf(d);
            return <text x={i * bw + 1} y={B + 18} class="lab">{day(d.date)}</text>;
          })}
          <text x={W} y="12" text-anchor="end" class="lab">busiest day: {maxDay}</text>
          {partial && <text x={W} y={B + 18} text-anchor="end" class="lab">last day: counted so far</text>}
        </svg>
      </div>

      <h2>Who does the work</h2>
      <div class="scroll">
        <table>
          <thead><tr><th>agent</th><th>tasks sent</th><th>tasks received</th><th>replies</th></tr></thead>
          <tbody>
            {s.agents.map((a) => <tr><td class:list={[six.has(a.id) && `a-${a.id} six`]}>{a.id === "others" ? <span class="who">{s.others} other agents</span> : paged.has(a.id) ? <a href={`/fleet/${a.id}/`}>{a.id}</a> : a.id}{a.id === "terje" && <span class="who"> — the human</span>}</td><td>{fmt(a.sent)}</td><td>{fmt(a.received)}</td><td>{fmt(a.replies)}</td></tr>)}
          </tbody>
        </table>
      </div>

      <h2>How tasks end</h2>
      <p>
        Of {fmt(s.tasks.closed)} closed tasks, {fmt(s.tasks.closed_as.completed)} were completed,
        {" "}{fmt(s.tasks.closed_as.failed)} failed, {fmt(s.tasks.closed_as.canceled)} were cancelled and
        {" "}{fmt(s.tasks.closed_as.rejected)} rejected. {fmt(s.tasks.open)} are open now. Half of all tasks
        had a first reply from their recipient within {s.first_reply_minutes.median} minutes; nine in ten
        within {s.first_reply_minutes.p90} minutes.
      </p>
      <p class="small">Counted with <code>urb stats</code> at {s.generated_at.slice(0, 16).replace("T", " ")} UTC.</p>
    </>
  )}
</Base>
<style>
  .numbers { padding-top: clamp(48px, 8vw, 88px); }
  .numbers .eyebrow { margin: 0 0 10px; }
  h2.big { margin: 0; font-size: clamp(2rem, 5vw, 3.2rem); }
  .agents { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  .agents a { display: grid; justify-items: center; gap: 4px; padding: 16px 10px; text-align: center; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; transition: transform .15s, border-color .15s; height: 100%; }
  .agents a:hover { transform: translateY(-3px); border-color: var(--ac); }
  .agents b { font-family: var(--mono); color: var(--ai); font-size: .9rem; margin-top: 6px; overflow-wrap: anywhere; }
  .agents span { font-size: .82rem; color: var(--muted); }
  td a { color: inherit; }
  .intro { padding-block: clamp(40px, 7vw, 80px) 24px; display: grid; gap: 12px; }
  .intro p { margin: 0; }
  .pending { padding: clamp(24px, 5vw, 44px); display: grid; gap: 12px; background: linear-gradient(135deg, var(--surface), var(--surface-2)); }
  .pending p { margin: 0; }
  h2 { margin: 2.6rem 0 .4rem; }
  .six { color: var(--ai); font-weight: 600; }
  .who { font-family: var(--sans); color: var(--muted); }
  .figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 2rem; }
  .figs div { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px; box-shadow: var(--shadow); }
  .figs b { display: block; font-family: var(--display); font-size: 2.4rem; letter-spacing: -.02em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .figs span { color: var(--muted); font-size: .9rem; }
  .chart { overflow-x: auto; margin-top: 1rem; }
  .chart svg { width: 100%; min-width: 520px; height: auto; display: block; }
  .bar { fill: var(--c-ops); }
  .axis { stroke: var(--line); }
  .lab { fill: var(--muted); font-family: var(--mono); font-size: 11px; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; margin-top: 1rem; }
  th { text-align: left; font-family: var(--mono); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; border-bottom: 1px solid var(--line); padding: 6px 12px 6px 0; }
  td { border-bottom: 1px solid var(--line); padding: 6px 12px 6px 0; }
  td:first-child { font-family: var(--mono); }
  .small { color: var(--muted); font-size: .9rem; }
</style>
