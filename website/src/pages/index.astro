---
// The example for Terje's talk on developing with agents (2026-09-30): a real fleet, what it
// builds, and what happened when an AI wrote about the agents and they checked it.
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import DeckCard from "../components/DeckCard.astro";
import GotWrong from "../components/GotWrong.astro";
import { tools, repoLabel } from "../data/tools";
import { decks } from "../data/decks";
import { agent, withPage } from "../data/agents";
const featured = decks.filter((d) => d.audience === "anyone").slice(0, 3);
// Three corrections to show on the front page; the rest are on each agent's page.
const examples = ["tor-agent", "ops", "sovdev-logger"].map((id) => agent(id)!);
const checked = withPage.filter((a) => a.gotWrong).length;
const asked = withPage.filter((a) => a.id !== "marketing").length;
// Where each character sits in the hero's constellation, as a percentage of the box.
const spots: Record<string, [number, number, number]> = {
  "ops-dev": [50, 47, 30], atlas: [21, 19, 20], "tor-agent": [79, 17, 21],
  imac: [19, 74, 18], "dev-templates": [80, 76, 19], ops: [50, 93, 17],
};
const six = ["ops-dev", "atlas", "tor-agent", "imac", "dev-templates", "ops"];
---
<Base title="Urbalurba · SovereignSky — developing with a fleet of AI agents">
  <section class="hero">
    <div class="copy">
      <p class="eyebrow">Developing with agents · a working example</p>
      <h1>We asked an AI to interview the AI agents that build our software.</h1>
      <p class="lead">About twenty AI agents build and run SovereignSky's open-source tools. Each agent owns one repository or one job, and they hand work to each other as tasks on a shared list of GitHub issues — the bus. A person, Terje Christensen, decides what gets built and what gets published.</p>
      <p class="lead">This site is the example for a talk on developing with agents. One of the agents, marketing, wrote it.</p>
      <div class="cta">
        <a class="btn" href="/fleet/">Meet the agents <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/presentations/">See the talks</a>
      </div>
    </div>
    <div class="constellation" aria-label="Six of the agents" role="img">
      <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {six.filter((id) => id !== "ops-dev").map((id) => <line x1="50" y1="47" x2={spots[id][0]} y2={spots[id][1]} />)}
      </svg>
      {six.map((id, i) => {
        const [x, y, s] = spots[id];
        return (
          <a class={`node a-${id}`} href={`/fleet/${id}/`} style={`--x:${x}%; --y:${y}%; --s:${s}%; --d:${i * 0.6}s`}>
            <Avatar id={id} size={200} />
            <span>{id}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <header>
      <p class="eyebrow">What the AI got wrong</p>
      <h2>Every agent corrected what the AI wrote about it.</h2>
      <p class="lead">marketing drafted a page for each agent from its description of itself, and sent it to the agent to check before publishing. {checked} of the {asked} agents it asked sent corrections — mostly for claiming more than was true. Three of them:</p>
    </header>
    <div class="grid gws">{examples.map((a) => <GotWrong a={a} compact />)}</div>
    <p class="more-line"><a class="more" href="/fleet/">Every agent's correction is on its page →</a></p>
  </section>

  <section class="section" id="tools">
    <header>
      <p class="eyebrow">What the agents build</p>
      <h2>Six open-source tools, one agent each.</h2>
    </header>
    <div class="grid tools">
      {tools.map((t) => (
        <article class={`card tool a-${t.agent}`}>
          <a class="head" href={`/fleet/${t.agent}/`}>
            <Avatar id={t.agent} size={44} />
            <span class="tag">built by {t.agent}</span>
          </a>
          <h3><a href={t.href}>{t.name}</a></h3>
          <p>{t.what}</p>
          <a class="repo" href={t.repository}>{repoLabel(t.repository)}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section how">
    <header>
      <p class="eyebrow">How the work flows</p>
      <h2>How the agents work together</h2>
    </header>
    <ol class="steps">
      <li class="card a-atlas"><span class="n">1</span><h3>One agent per repository</h3><p>Each agent owns its code, documentation and releases. When it needs something from another agent's repository, it asks that agent.</p></li>
      <li class="card a-ops-dev"><span class="n">2</span><h3>Tasks on the bus</h3><p>A request is a GitHub issue addressed to one agent. The recipient works it, hands it back, and the sender accepts it. A separate tester checks what a builder says is finished.</p></li>
      <li class="card a-tor-agent"><span class="n">3</span><h3>A person decides</h3><p>Anything public, anything that costs money, and anything that cannot be undone waits for Terje.</p></li>
    </ol>
    <p class="more-line"><a class="more" href="/how-it-works/">How the bus works, in detail →</a></p>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <header class="row">
        <div>
          <p class="eyebrow">Presentations</p>
          <h2>The interviews, as talks.</h2>
        </div>
        <a class="more" href="/presentations/">All presentations →</a>
      </header>
      <div class="grid">{featured.map((d) => <DeckCard deck={d} />)}</div>
    </section>
  )}
</Base>
<style>
  .hero { display: grid; gap: 40px; align-items: center; padding-block: clamp(40px, 7vw, 88px) 0; }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.15fr 1fr; gap: 56px; } }
  .hero h1 { margin-bottom: 20px; font-size: clamp(2.2rem, 5.6vw, 3.8rem); }
  .hero .lead { margin: 0 0 12px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

  .constellation { position: relative; width: 100%; max-width: 520px; aspect-ratio: 1 / 1.02; margin-inline: auto; }
  .links { position: absolute; inset: 0; width: 100%; height: 100%; }
  .links line { stroke: var(--line); stroke-width: .5; stroke-dasharray: 1.4 1.4; vector-effect: non-scaling-stroke; }
  .node { position: absolute; left: var(--x); top: var(--y); width: var(--s); transform: translate(-50%, -50%); display: grid; grid-template-columns: 100%; justify-items: center; gap: 6px; text-decoration: none; }
  .node :global(.av) { width: 100%; height: auto; box-shadow: 0 0 0 5px var(--ground), 0 18px 30px -18px rgba(22,33,58,.55); }
  .node span { font-family: var(--mono); font-size: .72rem; color: var(--ai); font-weight: 600; background: var(--ground); padding: 0 6px; border-radius: 6px; white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) {
    .node { animation: bob 6s ease-in-out var(--d) infinite; }
    @keyframes bob { 0%, 100% { transform: translate(-50%, -50%); } 50% { transform: translate(-50%, calc(-50% - 6px)); } }
  }

  .gws { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .more-line { margin-top: 18px; }

  .tool { display: grid; gap: 10px; align-content: start; padding: 22px; border-top: 4px solid var(--ac); }
  .tool .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; text-decoration: none; }
  .tool h3 a { color: var(--ink); text-decoration: none; }
  .tool h3 a:hover { text-decoration: underline; }
  .tool p { margin: 0; color: var(--muted); }
  .tag { font-family: var(--mono); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ai); }
  .repo { font-family: var(--mono); font-size: .8rem; color: var(--ai); overflow-wrap: anywhere; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .steps li { padding: 24px; }
  .steps p { margin: 10px 0 0; color: var(--muted); }
  .n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ac); color: #16213A; font-family: var(--display); font-weight: 800; font-size: 1.15rem; margin-bottom: 16px; }

  .row { grid-auto-flow: row; }
  @media (min-width: 640px) { .row { display: flex !important; justify-content: space-between; align-items: end; } }
</style>
