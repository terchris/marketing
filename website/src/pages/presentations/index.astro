---
import Base from "../../layouts/Base.astro";
import DeckCard from "../../components/DeckCard.astro";
import { decks } from "../../data/decks";
// Lists whatever decks exist in presentations/ — nothing is typed twice.
const anyone = decks.filter((d) => d.audience === "anyone");
const peers = decks.filter((d) => d.audience !== "anyone");
---
<Base title="Presentations · Urbalurba" description="Talks about the Urbalurba agent fleet, many of them in the agents' own words.">
  <section class="intro">
    <p class="eyebrow">Presentations</p>
    <h1>The interviews, as talks.</h1>
    <p class="lead">An AI sent the agents questions on the bus and built these talks from their answers. Where an agent got a fact wrong in its own interview, the last slide of the talk says so.</p>
    <div class="how card">
      <b>Presenting?</b> Each deck is a single HTML file. Open it, then use
      <kbd>←</kbd> <kbd>→</kbd> to move, <kbd>N</kbd> for speaker notes, <kbd>T</kbd> to switch theme and <kbd>F</kbd> for full screen.
      Without its script, a deck reads as one scrolling page.
    </div>
  </section>

  {decks.length === 0 && <p class="empty">No presentations are published yet.</p>}

  {anyone.length > 0 && (
    <section class="section">
      <header><h2>For anyone</h2></header>
      <div class="grid">{anyone.map((d) => <DeckCard deck={d} />)}</div>
    </section>
  )}

  {peers.length > 0 && (
    <section class="section">
      <header><h2>For technical peers</h2></header>
      <div class="grid">{peers.map((d) => <DeckCard deck={d} />)}</div>
    </section>
  )}
</Base>
<style>
  .intro { padding-block: clamp(40px, 7vw, 80px) 0; display: grid; gap: 18px; }
  .intro p { margin: 0; }
  .how { padding: 16px 20px; color: var(--muted); max-width: 72ch; line-height: 1.9; }
  .how b { color: var(--ink); }
  kbd { font-family: var(--mono); font-size: .8em; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 1px 7px; background: var(--ground); color: var(--ink); }
  .empty { color: var(--muted); margin-top: 32px; }
</style>
