---
// What marketing's first draft said about an agent, and the agent's reply, verbatim from its check
// task (#1624–#1636; cleared by Terje, 2026-09-29).
import Avatar from "./Avatar.astro";
import type { Agent } from "../data/agents";
interface Props { a: Agent; compact?: boolean }
const { a, compact = false } = Astro.props;
const g = a.gotWrong!;
---
<figure class:list={["card", "gw", `a-${a.id}`, { compact }]}>
  <div class="draft">
    <span class="label">{g.wrote ? "The AI's draft said" : "The AI's draft left out"}</span>
    <p class:list={[g.wrote && "struck"]}>{g.wrote ?? g.missed}</p>
  </div>
  <div class="reply">
    <span class="label who">{compact && <Avatar id={a.id} size={28} />}<b>{a.id}</b> replied</span>
    {(compact ? g.said.slice(0, 1) : g.said).map((q) => <blockquote>“{q}”</blockquote>)}
  </div>
</figure>
<style>
  .gw { margin: 0; padding: 18px 20px; display: grid; gap: 12px; border-left: 4px solid var(--ac); }
  .label { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .label b { color: var(--ai); text-transform: none; letter-spacing: 0; font-size: .85rem; }
  .draft p { margin: 6px 0 0; color: var(--muted); font-style: italic; }
  .struck { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--human) 70%, transparent); text-decoration-thickness: 2px; }
  blockquote { margin: 8px 0 0; font-size: 1.05rem; line-height: 1.45; color: var(--quote); }
  .compact blockquote { font-size: 1rem; }
</style>
